{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ModelHealthMonitor",
  "version": "1.0.0",
  "identifier": "com.mhc.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "模型健康监控中心",
        "width": 1280,
        "height": 860,
        "url": "http://192.168.0.193:7600"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
