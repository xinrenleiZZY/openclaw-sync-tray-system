# 模型健康监控中心 - 环境变量示例
# 复制为 .env 后填入真实值；.env 已被 .gitignore 忽略，切勿提交

# 本机对外 IP（虚拟机通过局域网访问 7601 端口推送）
MHC_HOST=192.168.1.100
MHC_API_PORT=7601
MHC_WEB_PORT=7600
MHC_DB_PORT=7602

# 数据库口令（docker-compose.yml 必填）
DB_PASSWORD=请填写数据库口令

# 浏览器端（Next.js 客户端组件）使用的地址变量，需 NEXT_PUBLIC_ 前缀
NEXT_PUBLIC_MHC_HOST=192.168.1.100
NEXT_PUBLIC_MHC_API_PORT=7601

# 可选：设置后虚拟机推送必须携带 X-Push-Token 头
MHC_PUSH_TOKEN=

# 飞书开放平台应用
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
# 飞书 Wiki 节点 token（「openclaw登记」表格所在节点）
FEISHU_WIKI_TOKEN=
FEISHU_SHEET_REGISTER=openclaw登记

# feishu_wiki_api/download_wiki.py 使用的 Wiki 节点 token
WIKI_NODE_TOKEN=
